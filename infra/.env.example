# Modelo do ambiente de produção. Copie para `infra/.env` e preencha.
#
#     cp infra/.env.example infra/.env
#
# Este arquivo é versionado; o `.env` que você criar a partir dele NÃO é.

# ── Endereço servido pelo Caddy ─────────────────────────────────
# O domínio real em máquina exposta à internet (o Caddy emite o certificado
# pelo Let's Encrypt). Atrás do túnel Cloudflare, `infra/.env.tunnel` sobrepõe
# com ":80", porque lá o TLS termina na borda.
SITE_ADDRESS=seudominio.com

# Para onde o Let's Encrypt avisa que o certificado vai expirar.
ACME_EMAIL=voce@seudominio.com

HTTP_PORT=80
HTTPS_PORT=443

# ── Contato e redes ─────────────────────────────────────────────
# Entram no build (o Next substitui `NEXT_PUBLIC_*` ao compilar). Se ficarem
# vazios, o site usa os exemplos de `src/content/site.ts` e funciona igual.
NEXT_PUBLIC_SOCIAL_HANDLE=@seuinstagram
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/seuinstagram
NEXT_PUBLIC_TIKTOK=https://tiktok.com/@seuinstagram
NEXT_PUBLIC_WHATSAPP=https://wa.me/5500000000000
NEXT_PUBLIC_EMAIL=contato@seudominio.com
