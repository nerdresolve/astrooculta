# Copie para infra/.env.local (fora do Git) para rodar na sua máquina.
#
#     cp infra/.env.local.example infra/.env.local
#
# Sobrepõe infra/.env, que tem os valores de produção.

# ":80" faz o Caddy servir HTTP puro, sem tentar emitir certificado. Pedir
# certificado para "localhost" falharia — o Let's Encrypt não valida domínio
# que não resolve na internet.
SITE_ADDRESS=:80

# Portas altas evitam pedir privilégio de administrador no Windows e no macOS.
HTTP_PORT=8080
HTTPS_PORT=8443
