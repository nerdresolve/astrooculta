# Copie para infra/.env.tunnel (fora do Git) para publicar pelo túnel Cloudflare.
#
#     cp infra/.env.tunnel.example infra/.env.tunnel
#
# Usado só por `npm run publish`, que soma este arquivo por cima do infra/.env.

# ── Endereço servido pelo Caddy ────────────────────────────────
# ":80" e NÃO o domínio: atrás do túnel, quem termina o TLS público é a
# Cloudflare. Se o Caddy visse um domínio aqui, tentaria emitir certificado
# Let's Encrypt — que falharia, porque a validação exige a porta 80 aberta na
# internet, e o túnel existe justamente para não abrir porta nenhuma.
SITE_ADDRESS=:80

# ── Portas no host ─────────────────────────────────────────────
# Altas e ligadas só ao loopback conceitualmente: com túnel, ninguém de fora
# alcança a máquina diretamente. Evita conflito com outros serviços.
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Credencial do túnel ────────────────────────────────────────
# SEGREDO. Não versione este arquivo.
#
# Onde obter: painel da Cloudflare → Zero Trust → Networks → Tunnels →
# criar o túnel → escolher "Docker" → o token é a string longa que aparece
# no comando exibido, depois de `--token`.
#
# Um token dá controle sobre o túnel: quem o tiver consegue publicar tráfego
# nesse hostname. Trate como senha; se vazar, gire pelo painel.
TUNNEL_TOKEN=cole-o-token-aqui
